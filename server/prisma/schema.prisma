datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                    String            @id @default(uuid())
  fullName              String
  email                 String            @unique
  phone                 String
  passwordHash          String
  role                  String            @default("USER") // USER, SUPER_ADMIN
  profilePhoto          String?
  bloodGroup            String?
  address               String?
  city                  String?
  state                 String?
  country               String?
  pincode               String?
  emergencyContactName  String?
  emergencyContactPhone String?
  medicalNotes          String?
  isEmailVerified       Boolean           @default(false)
  emailOtp              String?
  emailOtpExpiresAt     DateTime?
  subscriptionStatus    String            @default("INACTIVE") // INACTIVE, ACTIVE, EXPIRED
  subscriptionExpiresAt DateTime?
  currentPlanId         String?
  safetyStatus          String            @default("SAFE") // SAFE, SOS_ACTIVE, JOURNEY_ACTIVE
  quickSosMode          String            @default("STANDARD") // STANDARD, SILENT
  onboardingStep        Int               @default(1)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  trustedContacts       TrustedContact[]
  sosSessions           SosSession[]
  journeys              Journey[]
  liveShares            LiveShareSession[]
  safetyCheckins        SafetyCheckin[]
  auditLogs             AuditLog[]
  paymentHistories      PaymentHistory[]
}

model Plan {
  id               String           @id @default(uuid())
  name             String
  description      String?
  basePrice        Float            @default(24.0)
  gstPercentage    Float            @default(18.0)
  totalPrice       Float            @default(28.32)
  durationDays     Int              @default(30)
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  paymentHistories PaymentHistory[]
}

model PaymentHistory {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId        String?
  plan          Plan?    @relation(fields: [planId], references: [id])
  txnid         String   @unique
  amount        Float
  baseAmount    Float
  gstAmount     Float
  gstPercentage Float
  status        String   @default("PENDING") // PENDING, SUCCESS, FAILED
  payuMoneyId   String?
  paymentMode   String?
  hash          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model TrustedContact {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  relationship  String
  phone         String
  email         String
  isVerified    Boolean  @default(true)
  priorityOrder Int      @default(1)
  createdAt     DateTime @default(now())
}

model SosSession {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  status         String        @default("ACTIVE") // ACTIVE, RESOLVED, CANCELLED
  isSilent       Boolean       @default(false)
  shareToken     String        @unique @default(uuid())
  startedAt      DateTime      @default(now())
  resolvedAt     DateTime?
  resolutionNote String?
  locations      SosLocation[]
  alerts         SosAlert[]
}

model SosLocation {
  id           String     @id @default(uuid())
  sosSessionId String
  sosSession   SosSession @relation(fields: [sosSessionId], references: [id], onDelete: Cascade)
  latitude     Float
  longitude    Float
  accuracy     Float?
  altitude     Float?
  speed        Float?
  heading      Float?
  recordedAt   DateTime   @default(now())
}

model SosAlert {
  id           String     @id @default(uuid())
  sosSessionId String
  sosSession   SosSession @relation(fields: [sosSessionId], references: [id])
  channel      String     // EMAIL, SMS, WEBSOCKET
  recipient    String
  status       String     @default("SENT") // SENT, FAILED
  sentAt       DateTime   @default(now())
}

model LiveShareSession {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  shareToken      String   @unique
  durationMinutes Int
  expiresAt       DateTime
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
}

model Journey {
  id              String            @id @default(uuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id])
  originName      String
  destinationName String
  originLat       Float
  originLng       Float
  destLat         Float
  destLng         Float
  expectedArrival DateTime
  status          String            @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, OVERDUE, ESCALATED
  shareToken      String            @unique
  startedAt       DateTime          @default(now())
  completedAt     DateTime?
  locations       JourneyLocation[]
}

model JourneyLocation {
  id         String   @id @default(uuid())
  journeyId  String
  journey    Journey  @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  latitude   Float
  longitude  Float
  recordedAt DateTime @default(now())
}

model SafetyCheckin {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  intervalMins Int
  triggerAt    DateTime
  status       String    @default("PENDING") // PENDING, CONFIRMED_SAFE, EXPIRED_ESCALATED
  createdAt    DateTime  @default(now())
}

model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("SUPER_ADMIN") // SUPER_ADMIN
  createdAt    DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  details   String   @db.Text
  ipAddress String?
  createdAt DateTime @default(now())
}
